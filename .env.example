EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack hosted checkout (Initialize API). Test secret from Paystack dashboard → Settings → API Keys.
# Never commit real keys. For production, move initialize to a Supabase Edge Function instead of the app.
EXPO_PUBLIC_PAYSTACK_SECRET_KEY=sk_test_your_secret_key
